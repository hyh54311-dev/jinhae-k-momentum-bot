# [한국투자증권 API & 텔레그램 환경변수 설정 예시]
# GitHub Actions 사용 시 Repository Secrets 에 아래 키 이름으로 등록합니다.

KIS_MOMENTUM_APP_KEY=your_kis_app_key_here
KIS_MOMENTUM_APP_SECRET=your_kis_app_secret_here
KIS_PENSION_CANO=12345678
KIS_STOCK_CANO=87654321
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# 테스트 모드 옵션 (실전 매매 시 False)
KIS_MOCK=False
KIS_DRY_RUN=False
MAX_ORDER_AMOUNT=100000000
